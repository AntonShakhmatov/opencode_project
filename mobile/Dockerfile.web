# ============================================================
# Stage 1: Build Flutter web
# ============================================================
FROM ghcr.io/cirruslabs/flutter:stable AS web-builder
WORKDIR /app

COPY mobile/pubspec.yaml mobile/pubspec.lock ./
RUN flutter pub get

COPY mobile/ ./
RUN flutter build web --release --dart-define=API_URL=/api

# ============================================================
# Stage 2: Serve static files with nginx
# ============================================================
FROM nginx:1.27-alpine AS web-run

# Nginx config with API and WebSocket proxy to backend
COPY mobile/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=web-builder /app/build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]